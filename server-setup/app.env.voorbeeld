# ============================================================
#  /etc/belastinghulp/app.env  —  geheimen en instellingen van de app
#
#  NOOIT IN GIT. Dit voorbeeld staat in de repo; het echte bestand staat
#  alleen op de server, eigenaar root, groep bhz-app, rechten 640.
#  app-installeren.sh zet dit voorbeeld neer en vult BHZ_GEHEIM zelf in.
#  Na een wijziging: sudo systemctl restart belastinghulp-app
#
#  Opmaak: SLEUTEL=waarde, zonder spaties rond het =-teken.
# ============================================================

# --- Algemeen (meestal niet aanpassen) ---
BHZ_BASIS_URL=https://belastinghulpzaanstad.nl
BHZ_POORT=8790
BHZ_DB=/var/lib/belastinghulp/leads.db
BHZ_BACKUP_MAP=/var/backups/belastinghulp
BHZ_TELLINGEN_MAP=/var/log/belastinghulp/tellingen

# Willekeurig geheim van 64 tekens. Ondertekent de bevestig- en afmeldlinks.
# Verander je het, dan werken de links in eerder verstuurde mails niet meer.
BHZ_GEHEIM=

# --- Mail via Brevo (zie APP.md, stap 3) ---
MAIL_VAN=info@belastinghulpzaanstad.nl
MAIL_VAN_NAAM=Belastinghulp Zaanstad
# Waar de melding van elke aanvraag en het dagoverzicht heen gaan
MAIL_MELDINGEN_AAN=info@belastinghulpzaanstad.nl

# Aanbevolen: versturen via de API van Brevo (HTTPS). Alleen zo kan Brevo
# het volgen per persoon uitzetten (zie APP.md, stap 4e). Een API-sleutel uit
# Brevo > SMTP & API > API-sleutels; NIET de SMTP-sleutel.
MAIL_VIA=brevo-api
BREVO_API_SLEUTEL=

# Alternatief: SMTP. Poort 2525 omdat DigitalOcean 25, 465 en 587 blokkeert.
# Wordt alleen gebruikt als MAIL_VIA hierboven weg is. Via SMTP volgt Brevo
# opens en kliks per persoon; niet gebruiken voor de herinneringslijst.
SMTP_HOST=smtp-relay.brevo.com
SMTP_POORT=2525
# De "Login" die Brevo toont onder SMTP & API > SMTP (letterlijk overnemen)
SMTP_GEBRUIKER=
# Een SMTP-sleutel uit datzelfde scherm. NIET uw Brevo-wachtwoord.
SMTP_WACHTWOORD=

# --- Optioneel ---
# Cloudflare Turnstile (staat uit in data/aanvraag.json)
#TURNSTILE_GEHEIM=

# Een pushbericht bij een nieuwe aanvraag, naast de mail. Zonder namen of
# nummers: alleen "Nieuwe aanvraag: <dienst>" en een link naar /beheer.
#PUSH_DIENST=pushover
#PUSHOVER_TOKEN=
#PUSHOVER_GEBRUIKER=
#PUSH_DIENST=telegram
#TELEGRAM_TOKEN=
#TELEGRAM_CHAT=
